# ==============================================================================
# FIELD SERVICE MANAGEMENT - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# Never commit .env.local or real credentials to source control.

# ------------------------------------------------------------------------------
# 1. REQUIRED CONFIGURATION
# ------------------------------------------------------------------------------
# Upstream backend API origin (Render URL in production or local server in dev).
# Used by Next.js server-side fetches and Edge proxy rewrites. No trailing slash.
BACKEND_URL=https://field-service-d24g.onrender.com

# Public API base path for client-side queries proxied through Next.js.
NEXT_PUBLIC_API_BASE=/api/v1

# Public canonical URL of the frontend application. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. OPTIONAL CONFIGURATION
# ------------------------------------------------------------------------------
# Public support and business contact information displayed in footer & contact page.
# Leave empty if you wish to omit specific fields from public display.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_ADDRESS=
NEXT_PUBLIC_CONTACT_HOURS=

# ------------------------------------------------------------------------------
# 3. DEMO ACCOUNTS (EVALUATION ONLY)
# ------------------------------------------------------------------------------
# Pre-populated credentials for one-click demo login buttons on the login screen.
# Leave values empty to automatically hide the quick demo login panel.
NEXT_PUBLIC_DEMO_ADMIN_EMAIL=
NEXT_PUBLIC_DEMO_ADMIN_PASSWORD=
NEXT_PUBLIC_DEMO_CUSTOMER_EMAIL=
NEXT_PUBLIC_DEMO_CUSTOMER_PASSWORD=
NEXT_PUBLIC_DEMO_TECHNICIAN_EMAIL=
NEXT_PUBLIC_DEMO_TECHNICIAN_PASSWORD=
